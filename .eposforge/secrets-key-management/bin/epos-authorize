#!/usr/bin/env python3
"""Authorize an sops-age recipient from a machine request or public key.

Usage:
  epos-authorize <machine> <fingerprint> <pubkey>
  epos-authorize --request-file <path>
  epos-authorize --public-key <key> <machine> <fingerprint>
"""
# vehicle-class: host-ci-glue

import pathlib
import subprocess
import sys


def main() -> int:
    core = pathlib.Path(__file__).resolve().parent.parent / "sops-age" / "scripts" / "setup_core.py"
    cmd = [sys.executable, str(core), "authorize", *sys.argv[1:]]
    return subprocess.call(cmd)


if __name__ == "__main__":
    raise SystemExit(main())
