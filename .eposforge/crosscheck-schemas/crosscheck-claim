#!/usr/bin/env bash
# crosscheck-claim — open a handoff at session start and append to it during the work.
#
# This is deliberately a shell command rather than hook plumbing: it works
# identically for every agent CLI, so the accumulate half of a cross-check loop
# needs no per-tool integration. Only the trigger ever does.
#
# The point of appending as you go rather than assembling at the end:
#   - a claim is written while the evidence is still on screen, together with the
#     exact command that produced it
#   - a trap gets recorded at the moment it is discovered, which is the only
#     moment anyone remembers it
#   - the claims survive a context compaction that would otherwise destroy the
#     author's ability to say what it did
#   - and writing into a field labelled `evidence_cmd` is a different act from
#     summarising at the end. "The commit says it is done" does not survive it.
#
# Usage:
#   crosscheck-claim open  --repo <path> [--policy-key K] [--clearance C] [--base SHA]
#                          [--agent A] [--provider P] [--model M] [--session S] [--round N]
#   crosscheck-claim scope --repo <path> [--policy-key K] [--clearance C] [--base SHA]
#   crosscheck-claim refresh                     # head_sha := HEAD, base_sha untouched
#   crosscheck-claim add   --statement TEXT [--class mechanical|judgment]
#                          [--evidence-cmd CMD] [--check TYPE[:VALUE]] [--expected TEXT]
#                          [--files a,b,c] [--cwd PATH]
#   crosscheck-claim trap  TEXT
#   crosscheck-claim attack TEXT                 # ranked; weakest point first
#   crosscheck-claim flag  --item X --judgment Y --rationale Z
#   crosscheck-claim out-of-scope TEXT
#   crosscheck-claim ground-rule TEXT
#   crosscheck-claim artifact PATH
#   crosscheck-claim headline NAME=VALUE
#   crosscheck-claim show [--jq FILTER]
#   crosscheck-claim path
#
# Payload location:  $CROSSCHECK_DIR/<session>/round-<N>/handoff.json
#   CROSSCHECK_DIR      default ~/.crosscheck   (keep it OUTSIDE any repo: a
#                       payload that can be committed will eventually be committed)
#   CROSSCHECK_SESSION  default a generated uuid, remembered in $CROSSCHECK_DIR/current
#                       AND in $CROSSCHECK_DIR/by-repo/<repo>. Any append opens a
#                       payload if this session has none, so `open` is optional:
#                       an instruction to record claims has to work when followed
#                       literally, and only one agent CLI has a session-start
#                       hook to run `open` first. The per-repo pointer is what
#                       finds that payload again, because `current` is a single
#                       slot on a host where sessions overlap.
#   CROSSCHECK_ROUND    default 1
#   CROSSCHECK_IMPLEMENTER_AGENT / _PROVIDER / _MODEL
#                       identity used when an append opens its own payload and
#                       there are no flags to read. Unset stays "unknown".
#   CROSSCHECK_HANDOFF_TOKEN_CAP  default 8000
#   CROSSCHECK_CLEARANCE_ORDER    adopter clearance vocabulary, weakest first,
#                       comma-separated (e.g. "low,medium,high,max"). When set,
#                       clearance_required is recomputed as the maximum over
#                       scope[].clearance on every write. The vocabulary and its
#                       ordering are adopter policy, so nothing is assumed here.
#
# Every append re-validates the whole payload against the schema, so a malformed
# claim fails at the moment it is written rather than at handoff time. A
# mechanical claim's --check is executed once on write, to prove the command runs
# at all; its result is not recorded here (crosscheck-run-checks.sh does that,
# immediately before the reviewer is spawned, when the tree is final).
#
# Exit: 0 ok · 1 rejected · 2 usage / IO.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
VALIDATE="$SCRIPT_DIR/validate-payload.sh"
# shellcheck source=lib/budget.sh
. "$SCRIPT_DIR/lib/budget.sh"
# shellcheck source=lib/claim-cwd.sh
. "$SCRIPT_DIR/lib/claim-cwd.sh"
ROOT="${CROSSCHECK_DIR:-$HOME/.crosscheck}"
ROUND="${CROSSCHECK_ROUND:-1}"
CAP="${CROSSCHECK_HANDOFF_TOKEN_CAP:-8000}"

usage() { sed -n '19,46p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2; exit 2; }
die()   { echo "crosscheck-claim: $*" >&2; exit 2; }
no()    { echo "crosscheck-claim: rejected — $*" >&2; exit 1; }

command -v jq >/dev/null 2>&1 || die "jq not found"

CMD="${1:-}"; shift 2>/dev/null || true
[[ -n "$CMD" ]] || usage

# ── session / payload path ───────────────────────────────────────────────────
session_file="$ROOT/current"
SESSION="${CROSSCHECK_SESSION:-}"
# A session that names itself can address its own payload without the `current`
# pointer, which is what makes it safe to open one while another session holds
# the pointer. A session that does not name itself has no other way back to its
# payload, so for it the pointer is load-bearing.
SESSION_EXPLICIT=0
[[ -n "$SESSION" ]] && SESSION_EXPLICIT=1
if [[ -z "$SESSION" && -r "$session_file" ]]; then SESSION="$(cat "$session_file")"; fi

payload_path() { printf '%s/%s/round-%s/handoff.json' "$ROOT" "$SESSION" "$ROUND"; }

# ── arg parsing (shared) ─────────────────────────────────────────────────────
A_REPO=""; A_KEY=""; A_CLEAR=""; A_BASE=""
A_AGENT=""; A_PROVIDER=""; A_MODEL=""
A_STATEMENT=""; A_CLASS=""; A_EVIDENCE=""; A_CHECK=""; A_EXPECTED=""; A_FILES=""; A_CWD=""
A_ITEM=""; A_JUDGMENT=""; A_RATIONALE=""; A_JQ=""
POSITIONAL=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo)         A_REPO="$2"; shift 2 ;;
    --policy-key)   A_KEY="$2"; shift 2 ;;
    --clearance)    A_CLEAR="$2"; shift 2 ;;
    --base)         A_BASE="$2"; shift 2 ;;
    --agent)        A_AGENT="$2"; shift 2 ;;
    --provider)     A_PROVIDER="$2"; shift 2 ;;
    --model)        A_MODEL="$2"; shift 2 ;;
    --session)      SESSION="$2"; SESSION_EXPLICIT=1; shift 2 ;;
    --round)        ROUND="$2"; shift 2 ;;
    --statement)    A_STATEMENT="$2"; shift 2 ;;
    --class)        A_CLASS="$2"; shift 2 ;;
    --evidence-cmd) A_EVIDENCE="$2"; shift 2 ;;
    --check)        A_CHECK="$2"; shift 2 ;;
    --expected)     A_EXPECTED="$2"; shift 2 ;;
    --files)        A_FILES="$2"; shift 2 ;;
    --cwd)          A_CWD="$2"; shift 2 ;;
    --item)         A_ITEM="$2"; shift 2 ;;
    --judgment)     A_JUDGMENT="$2"; shift 2 ;;
    --rationale)    A_RATIONALE="$2"; shift 2 ;;
    --jq)           A_JQ="$2"; shift 2 ;;
    -h|--help)      usage ;;
    --) shift; while [[ $# -gt 0 ]]; do POSITIONAL+=("$1"); shift; done ;;
    -*) die "unknown arg: $1" ;;
    *)  POSITIONAL+=("$1"); shift ;;
  esac
done

# ── write helpers ────────────────────────────────────────────────────────────
# Recompute the budget on every write and re-validate, so the payload is never
# left in a state the reviewer could not be handed.
finish() {
  local file="$1" tmp="$1.tmp"

  # clearance_required is the MAXIMUM over scope[].clearance — a review that
  # touches four repositories is a review at the highest clearance of any of
  # them. The ordering is adopter policy, not part of this contract, so the
  # computation only happens when the adopter supplies one.
  if [[ -n "${CROSSCHECK_CLEARANCE_ORDER:-}" ]]; then
    jq --arg order "$CROSSCHECK_CLEARANCE_ORDER" '
      ($order | split(",") | map(gsub("^\\s+|\\s+$"; ""))) as $ord
      | ([ .scope[].clearance ] | map({c: ., r: ($ord | index(.) // -1)}) | max_by(.r)) as $top
      | if $top == null or $top.r < 0 then . else .clearance_required = $top.c end
    ' "$tmp" > "$tmp.c" && mv "$tmp.c" "$tmp"
  elif [[ "$(jq -r '[.scope[].clearance] | unique | length' "$tmp")" -gt 1 ]]; then
    echo "crosscheck-claim: NOTE scope spans several clearances and CROSSCHECK_CLEARANCE_ORDER is unset — clearance_required left as written" >&2
  fi

  refresh_budget "$tmp" "$CAP" || die "failed to write budget"

  if ! "$VALIDATE" handoff "$tmp" --schema-only >/dev/null; then
    "$VALIDATE" handoff "$tmp" --schema-only >&2
    rm -f "$tmp"
    no "the resulting payload does not conform; nothing was written"
  fi
  mv "$tmp" "$file"
}

# ensure_payload — make sure this session HAS a payload before anything appends
# to it. An append is the first thing an agent following its instructions
# actually types, so it has to work without a prior `open`; otherwise the
# instruction is only true on the one CLI that has a session-start hook.
ensure_payload() {
  local file repo ptr sess

  if (( SESSION_EXPLICIT )); then
    [[ -r "$(payload_path)" ]] && return 0
    repo="$(cwd_repo)"
    [[ -n "$repo" ]] || die "no handoff for session $SESSION, and $(pwd) is not inside a git repository. Run 'crosscheck-claim open --repo <path>'."
    echo "crosscheck-claim: no handoff for this session yet — opening one for $repo" >&2
    do_open "$repo" >/dev/null
    return 0
  fi

  repo="$(cwd_repo)"

  # The repository is the one piece of context an append always has, so it is
  # the first thing asked. `current` is a single slot on a host where sessions
  # overlap; resolving through it is how an append lands in a payload that
  # belongs to somebody else.
  if [[ -n "$repo" ]]; then
    if sess="$(read_repo_pointer "$(cd "$repo" && pwd -P)")"; then
      SESSION="$sess"
      return 0
    fi
  fi

  # Fall back to `current` only if the payload it names is actually about this
  # repository. A payload that never mentions the tree you are working in is
  # not yours, whatever the pointer says.
  file="$(payload_path)"
  if [[ -n "$SESSION" && -r "$file" && -n "$repo" ]]; then
    if jq -e --arg r "$(cd "$repo" && pwd -P)" \
          'any(.scope[]?; .repo_path == $r)' "$file" >/dev/null 2>&1; then
      # Resolved the slow way once; record it so the next append does not have
      # to depend on `current` still pointing here.
      bind_repo_pointer "$(cd "$repo" && pwd -P)"
      return 0
    fi
  fi

  [[ -n "$repo" ]] || die "no handoff yet, and $(pwd) is not inside a git repository — a payload has to name the tree it is about. Run 'crosscheck-claim open --repo <path>' from somewhere else."
  # Do not open under an id inherited from `current`: that id belongs to another
  # session, and writing a fresh payload into its namespace is how two sessions
  # end up sharing one. Mint an id and let the per-repo pointer find it again.
  SESSION=""
  echo "crosscheck-claim: no handoff for this session yet — opening one for $repo" >&2
  do_open "$repo" >/dev/null
}

edit() {  # edit <jq-filter> [jq args...]
  local file
  ensure_payload
  file="$(payload_path)"
  [[ -r "$file" ]] || die "no handoff at $file — run 'crosscheck-claim open --repo <path>' first"
  local filter="$1"; shift
  # Read-modify-write under an exclusive lock. Several agents run on this host
  # and two appends racing would silently drop one of them — which is the one
  # kind of loss this tool exists to prevent.
  exec 9>"$file.lock"
  flock -w 30 -x 9 || die "timed out waiting for the lock on $file"
  jq "$@" "$filter" "$file" > "$file.tmp" || die "jq edit failed"
  finish "$file"
  exec 9>&-
}

git_head() { git -C "$1" rev-parse HEAD 2>/dev/null; }
git_base() {
  # Session baseline: the commit the work started from. Falls back to HEAD, which
  # makes an empty diff, which is the correct answer for a session that has not
  # committed anything yet.
  git -C "$1" rev-parse HEAD 2>/dev/null
}
git_dirty() {
  if [[ -n "$(git -C "$1" status --porcelain 2>/dev/null)" ]]; then echo true; else echo false; fi
}

scope_entry_json() {
  local repo="$1" key="$2" clear="$3" base="$4"
  git -C "$repo" rev-parse --git-dir >/dev/null 2>&1 || die "$repo is not a git repository"
  local head dirty
  head="$(git_head "$repo")" || die "cannot read HEAD in $repo"
  [[ -n "$base" ]] || base="$(git_base "$repo")"
  dirty="$(git_dirty "$repo")"
  # Stamped ok because it was just read from this repository. It is true now and
  # says nothing about transport time — crosscheck-verify-scope.sh re-establishes
  # it there, which is where an ordinary pull will have moved things.
  jq -n --arg p "$(cd "$repo" && pwd -P)" --arg k "${key:-$(basename "$(cd "$repo" && pwd -P)")}" \
        --arg c "${clear:-unset}" --arg b "$base" --arg h "$head" --argjson d "$dirty" \
        --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        '{repo_path:$p, policy_key:$k, clearance:$c, base_sha:$b, head_sha:$h, dirty:$d,
          integrity:"ok", verified_at:$t}'
}

# ── opening a handoff ────────────────────────────────────────────────────────
# One implementation, two callers: the `open` verb, and the first append in a
# session that has no payload yet. The second caller is the important one — an
# instruction to "record claims as you go" that fails on its first command is
# not an instruction, and only one agent CLI has a session-start hook to run
# `open` for it.

# A per-repository pointer, written next to `current`. `current` is a single
# slot on a host where sessions overlap, so a bare append that resolves through
# it can land in a payload that does not exist — or in somebody else's. The
# repository is the one piece of context an append always has.
repo_pointer() {
  # Percent-encode rather than substitute: mapping every "/" to "_" makes
  # /a/b/c and /a/b_c the same filename, so a bare append can bind to another
  # tree's session with no error at all — the silent failure this pointer
  # exists to prevent.
  local p="${1#/}"
  p="${p//%/%25}"
  printf '%s/by-repo/%s' "$ROOT" "${p//\//%2F}"
}

# The filename this pointer had before it was percent-encoded. Upgrading in the
# middle of a live session must not orphan a payload: a miss on the new name
# would mint a second one, silently, mid-work.
legacy_repo_pointer() {
  local p="${1#/}"
  printf '%s/by-repo/%s' "$ROOT" "${p//\//_}"
}

# read_repo_pointer <abs repo path> — the session this tree belongs to, if any.
# Migrates a legacy pointer to the current name when it still resolves.
read_repo_pointer() {
  local repo="$1" ptr legacy sess
  ptr="$(repo_pointer "$repo")"
  if [[ -r "$ptr" ]]; then
    sess="$(cat "$ptr")"
    [[ -n "$sess" && -r "$ROOT/$sess/round-$ROUND/handoff.json" ]] && { printf '%s' "$sess"; return 0; }
  fi
  legacy="$(legacy_repo_pointer "$repo")"
  if [[ "$legacy" != "$ptr" && -r "$legacy" ]]; then
    sess="$(cat "$legacy")"
    if [[ -n "$sess" && -r "$ROOT/$sess/round-$ROUND/handoff.json" ]]; then
      mkdir -p "$ROOT/by-repo" 2>/dev/null
      printf '%s' "$sess" > "$ptr"
      printf '%s' "$sess"
      return 0
    fi
  fi
  return 1
}

# bind_repo_pointer <abs repo path> — this repo's appends belong to this session.
bind_repo_pointer() {
  local repo="$1"
  [[ -n "$repo" && -n "$SESSION" ]] || return 0
  mkdir -p "$ROOT/by-repo" 2>/dev/null
  printf '%s' "$SESSION" > "$(repo_pointer "$repo")"
}

cwd_repo() { git rev-parse --show-toplevel 2>/dev/null; }

# Same pointer preference as ensure_payload, without creating anything. `show`
# and `path` are how an agent checks what it has recorded; they must not answer
# about a different session's payload.
resolve_session_readonly() {
  local repo ptr sess file
  (( SESSION_EXPLICIT )) && return 0
  repo="$(cwd_repo)"
  if [[ -n "$repo" ]]; then
    if sess="$(read_repo_pointer "$(cd "$repo" && pwd -P)")"; then
      SESSION="$sess"
      return 0
    fi
    # `current` only counts if the payload it names is about this repository.
    file="$(payload_path)"
    if [[ -n "$SESSION" && -r "$file" ]]; then
      jq -e --arg r "$(cd "$repo" && pwd -P)" \
         'any(.scope[]?; .repo_path == $r)' "$file" >/dev/null 2>&1 || SESSION=""
    fi
  fi
  return 0
}


do_open() {  # do_open <repo> — sets SESSION, prints the payload path
  local repo="$1" root_abs prev prev_dir prev_payload dir file scope claim_current=1

  # A payload carries repository paths, revisions and claims. It must not be
  # committable — least of all into a public tree — and "we agreed not to" is
  # not a mechanism.
  mkdir -p "$ROOT" 2>/dev/null
  root_abs="$(cd "$ROOT" && pwd -P)" || die "cannot resolve $ROOT"
  if git -C "$root_abs" rev-parse --show-toplevel >/dev/null 2>&1; then
    die "CROSSCHECK_DIR ($root_abs) is inside the git work tree $(git -C "$root_abs" rev-parse --show-toplevel) — payloads must live outside every repository; set CROSSCHECK_DIR somewhere else"
  fi

  # Do not silently steal an in-flight session's pointer. Two agents running on
  # this host at once is normal, and the failure is invisible: the second
  # `open` repoints `current`, and the first session's next bare `add` lands in
  # the second session's payload.
  if [[ -s "$session_file" ]]; then
    prev="$(cat "$session_file")"
    prev_dir="$ROOT/$prev"
    # Liveness is a property of the session, not of round 1. Looking only at
    # round-$ROUND made a session whose payload had moved to round 2 invisible,
    # so `open` repointed `current` at exactly the moment the other session was
    # most active — the failure this guard exists to prevent.
    prev_payload=""
    if [[ "$prev" != "$SESSION" && -d "$prev_dir" ]]; then
      prev_payload="$(find "$prev_dir" -maxdepth 2 -name handoff.json \
                      -newermt "-${CROSSCHECK_SESSION_TTL:-8 hours}" -print -quit 2>/dev/null)"
    fi
    if [[ -n "$prev_payload" ]]; then
      # Leave the pointer where it is and open anyway. This used to require the
      # caller to name its own session; it no longer does, because the per-repo
      # pointer written below is how this payload is found again.
      claim_current=0
      echo "crosscheck-claim: note — session $prev is still active; leaving 'current' pointing at it." >&2
    fi
  fi

  if [[ -z "$SESSION" ]]; then
    if [[ -r /proc/sys/kernel/random/uuid ]]; then SESSION="$(cat /proc/sys/kernel/random/uuid)"
    else SESSION="$(date -u +%Y%m%dT%H%M%SZ)-$$"; fi
  fi
  dir="$ROOT/$SESSION/round-$ROUND"
  mkdir -p "$dir" || die "cannot create $dir"
  (( claim_current )) && printf '%s' "$SESSION" > "$session_file"
  bind_repo_pointer "$(cd "$repo" && pwd -P)"
  file="$dir/handoff.json"
  [[ -e "$file" ]] && die "handoff already exists at $file (use 'scope'/'add' to append)"

  scope="$(scope_entry_json "$repo" "$A_KEY" "$A_CLEAR" "$A_BASE")" || exit 2
  # An append that opens its own payload has no flags to read, so the identity
  # comes from the environment when the caller set it. Left unset it stays
  # "unknown", which is honest: an adopter that routes by vendor will refuse to
  # guess, and refusing is the correct end to "who wrote this?".
  jq -n --arg s "$SESSION" --argjson r "$ROUND" \
        --arg ag "${A_AGENT:-${CROSSCHECK_IMPLEMENTER_AGENT:-unknown}}" \
        --arg pr "${A_PROVIDER:-${CROSSCHECK_IMPLEMENTER_PROVIDER:-unknown}}" \
        --arg mo "${A_MODEL:-${CROSSCHECK_IMPLEMENTER_MODEL:-unknown}}" \
        --argjson sc "$scope" --arg cl "${A_CLEAR:-unset}" '
    {
      schema: "eposforge.crosscheck.handoff/1",
      round: $r,
      session: $s,
      implementer: {agent: $ag, provider: $pr, model: $mo},
      scope: [$sc],
      clearance_required: $cl,
      claims: [],
      headline_numbers: {},
      traps: [],
      attack_first: [],
      self_flagged: [],
      out_of_scope: [],
      artifacts: [],
      ground_rules: [
        "Read-only. Do not commit, push, or start stopped services.",
        "Verify content, not status: a green exit code is not evidence anything was read.",
        "Do not reuse the author'"'"'s scripts to check the author'"'"'s work."
      ],
      disposition_ref: null,
      budget: {est_tokens: 0, rendered_bytes: 0, cap: 0, over_budget: false}
    }' > "$file.tmp" || die "cannot write $file"
  finish "$file"
  printf '%s\n' "$file"
}

case "$CMD" in

open)
  [[ -n "$A_REPO" ]] || die "open needs --repo <path>"
  do_open "$A_REPO"
  ;;

scope)
  [[ -n "$A_REPO" ]] || die "scope needs --repo <path>"
  scope="$(scope_entry_json "$A_REPO" "$A_KEY" "$A_CLEAR" "$A_BASE")" || exit 2
  # Replace an existing entry for the same path rather than accumulating stale SHAs.
  edit '
    .scope = ((.scope | map(select(.repo_path != $e.repo_path))) + [$e])
  ' --argjson e "$scope"
  # Without this, a session that spans two repositories splits in half the
  # moment `current` belongs to somebody else: appends in the second tree find
  # no pointer, miss on `current`, and mint a second payload. The multi-repo
  # example in every adopter's docs is exactly that path.
  bind_repo_pointer "$(cd "$A_REPO" && pwd -P)"
  echo "scope: ${A_REPO}"
  ;;

refresh)
  # The payload records the tree as it was when the handoff opened. A session
  # that COMMITS its work therefore hands over base_sha == head_sha: an empty
  # commit range, from which coverage computes `uncovered: 0` for a change it
  # never looked at. That is the same vacuous zero the dirty-tree re-read was
  # added to prevent, wearing a different hat — and it is silent, because the
  # promised revision does still exist and does still sit on its branch, so
  # nothing is drifting and no integrity check fires.
  #
  # This advances head_sha, and NOTHING ELSE. base_sha is preserved exactly,
  # which is what makes it different from `scope --repo X` with no --base: that
  # re-reads the base from today's HEAD and silently destroys the baseline the
  # whole review is measured against.
  #
  # Call it when the work is finished and before the payload is prepared. Do not
  # call it after a round has been transported: at that point the promise has
  # been made, and moving head_sha to today's tip is the refresh that
  # crosscheck-verify-scope.sh exists to refuse.
  # Read-only resolution: refresh corrects a payload that exists. If none does,
  # there is nothing to correct, and minting one here would be a payload with no
  # claims dated at the end of the work — the reconstruction this design refuses.
  resolve_session_readonly
  file="$(payload_path)"
  [[ -r "$file" ]] || die "no handoff at $file — refresh corrects an existing payload, it does not open one"
  n=0
  while read -r repo; do
    [[ -n "$repo" ]] || continue
    if ! git -C "$repo" rev-parse --git-dir >/dev/null 2>&1; then
      echo "crosscheck-claim: refresh — $repo is not readable as a git repository; left as it was" >&2
      continue
    fi
    head="$(git_head "$repo")"; [[ -n "$head" ]] || continue
    dirty="$(git_dirty "$repo")"
    was="$(jq -r --arg r "$repo" '.scope[] | select(.repo_path == $r) | .head_sha' "$file")"
    edit '
      .scope |= map(if .repo_path == $r
                    then .head_sha = $h | .dirty = $d
                       | .integrity = "ok" | .verified_at = $t
                    else . end)
    ' --arg r "$repo" --arg h "$head" --argjson d "$dirty" \
      --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [[ "$was" != "$head" ]]; then
      [[ "$dirty" == "true" ]] && suffix=" (uncommitted changes as well)" || suffix=""
      echo "refresh: $repo ${was:0:12} -> ${head:0:12}$suffix"
      n=$((n + 1))
    fi
  done < <(jq -r '.scope[].repo_path' "$file")
  # Explicitly, because `(( n == 0 ))` as the last statement in this branch
  # makes the exit status the answer to "did nothing change" — and a caller
  # reading that as failure is a loop that stops on a successful refresh.
  if (( n == 0 )); then echo "refresh: every scope entry was already current"; fi
  exit 0
  ;;

add)
  [[ -n "$A_STATEMENT" ]] || die "add needs --statement"
  # Before the probe, not after: resolve_claim_cwd reads the payload's scope.
  ensure_payload
  if [[ -z "$A_CLASS" ]]; then
    if [[ -n "$A_CHECK" ]]; then A_CLASS="mechanical"; else A_CLASS="judgment"; fi
  fi
  case "$A_CLASS" in mechanical|judgment) ;; *) die "--class must be mechanical or judgment" ;; esac

  ctype=""; cval=""
  if [[ -n "$A_CHECK" ]]; then
    ctype="${A_CHECK%%:*}"
    [[ "$A_CHECK" == *:* ]] && cval="${A_CHECK#*:}"
  fi

  if [[ "$A_CLASS" == "mechanical" ]]; then
    [[ -n "$A_EVIDENCE" ]] || no "a mechanical claim needs --evidence-cmd; without it the claim cannot be falsified"
    [[ -n "$ctype" ]]      || no "a mechanical claim needs --check TYPE[:VALUE]; prose that cannot be executed never gets executed"
    case "$ctype" in
      exit0|absent) ;;
      equals|regex|count-eq|count-lt)
        [[ -n "$cval" ]] || no "check type '$ctype' needs a value: --check $ctype:<value>" ;;
      *) no "unknown check type '$ctype' (exit0|equals|regex|absent|count-eq|count-lt)" ;;
    esac
    # Prove the command at least runs, in the same directory run-checks will
    # use later. Do not probe in scope[0] just because it is first — that is
    # how a true exit0 claim about a later repo is refused at write.
    probe_cwd="$(resolve_claim_cwd "$(payload_path)" "$A_CWD" "$A_FILES" "" || true)"
    if [[ -z "$probe_cwd" ]]; then
      no "cannot tell which scope repo to run this in — pass --cwd <repo> or --files that exist in exactly one of them (refusing to probe in scope[0])"
    fi
    # Probe where the claim will later run, but do NOT bake the resolved
    # directory into the claim when the caller only passed --files. Writing it
    # freezes today's answer: the files[] fallback would never be consulted
    # again, so a scope entry added later, or a payload read on another host,
    # silently keeps a path that may no longer be the right one. An explicit
    # --cwd is the author's assertion and is recorded as written.
    ( cd "$probe_cwd" && bash -c "$A_EVIDENCE" ) >/dev/null 2>&1
    rc=$?
    if (( rc != 0 )); then
      if [[ "$ctype" == "exit0" ]]; then
        no "--check exit0 but the evidence command exited $rc right now in $probe_cwd; either the claim is false or the command is wrong"
      fi
      echo "crosscheck-claim: note — evidence command exited $rc on write in $probe_cwd (fine for check type '$ctype')" >&2
    fi
  fi

  check_json=null
  if [[ -n "$ctype" ]]; then
    if [[ -z "$cval" ]]; then
      check_json="$(jq -n --arg t "$ctype" '{type:$t}')"
    elif [[ "$cval" =~ ^-?[0-9]+$ ]]; then
      check_json="$(jq -n --arg t "$ctype" --argjson v "$cval" '{type:$t, value:$v}')"
    else
      check_json="$(jq -n --arg t "$ctype" --arg v "$cval" '{type:$t, value:$v}')"
    fi
  fi

  files_json="$(jq -Rn --arg f "$A_FILES" '$f | if . == "" then [] else split(",") | map(gsub("^\\s+|\\s+$";"")) | map(select(length>0)) end')"

  edit '
    (([.claims[].id | ltrimstr("c") | tonumber] | max // 0) + 1) as $n
    | .claims += [ ( {
        id: ("c" + ($n|tostring)),
        class: $cls,
        statement: $st,
        files: $files
      }
      + (if $ev == "" then {} else {evidence_cmd: $ev} end)
      + (if $exp == "" then {} else {expected: $exp} end)
      + (if $chk == null then {} else {check: $chk} end)
      + (if $cwd == "" then {} else {cwd: $cwd} end) ) ]
  ' --arg cls "$A_CLASS" --arg st "$A_STATEMENT" --arg ev "$A_EVIDENCE" \
    --arg exp "$A_EXPECTED" --argjson chk "$check_json" --argjson files "$files_json" \
    --arg cwd "$A_CWD"
  jq -r '.claims[-1] | "claim " + .id + " (" + .class + ") recorded"' "$(payload_path)"
  ;;

trap)
  [[ ${#POSITIONAL[@]} -gt 0 ]] || die "trap needs the text as an argument"
  edit '.traps += [$t]' --arg t "${POSITIONAL[*]}"
  echo "trap recorded"
  ;;

attack)
  [[ ${#POSITIONAL[@]} -gt 0 ]] || die "attack needs the text as an argument"
  edit '.attack_first += [$t]' --arg t "${POSITIONAL[*]}"
  echo "attack-first recorded"
  ;;

out-of-scope)
  [[ ${#POSITIONAL[@]} -gt 0 ]] || die "out-of-scope needs the text as an argument"
  edit '.out_of_scope += [$t]' --arg t "${POSITIONAL[*]}"
  echo "out-of-scope recorded (the reviewer may challenge it)"
  ;;

ground-rule)
  [[ ${#POSITIONAL[@]} -gt 0 ]] || die "ground-rule needs the text as an argument"
  edit '.ground_rules += [$t]' --arg t "${POSITIONAL[*]}"
  echo "ground rule recorded"
  ;;

artifact)
  [[ ${#POSITIONAL[@]} -gt 0 ]] || die "artifact needs a path"
  edit '.artifacts += [$t]' --arg t "${POSITIONAL[*]}"
  echo "artifact recorded"
  ;;

headline)
  [[ ${#POSITIONAL[@]} -gt 0 ]] || die "headline needs NAME=VALUE"
  kv="${POSITIONAL[0]}"
  [[ "$kv" == *=* ]] || die "headline needs NAME=VALUE"
  k="${kv%%=*}"; v="${kv#*=}"
  if [[ "$v" =~ ^-?[0-9]+$ ]]; then
    edit '.headline_numbers[$k] = $v' --arg k "$k" --argjson v "$v"
  else
    edit '.headline_numbers[$k] = $v' --arg k "$k" --arg v "$v"
  fi
  echo "headline recorded"
  ;;

flag)
  [[ -n "$A_ITEM" && -n "$A_JUDGMENT" && -n "$A_RATIONALE" ]] \
    || die "flag needs --item, --judgment and --rationale"
  edit '.self_flagged += [{item:$i, judgment:$j, rationale:$r}]' \
    --arg i "$A_ITEM" --arg j "$A_JUDGMENT" --arg r "$A_RATIONALE"
  echo "self-flagged call recorded"
  ;;

show)
  resolve_session_readonly
  file="$(payload_path)"
  [[ -r "$file" ]] || die "no handoff at $file"
  if [[ -n "$A_JQ" ]]; then jq -r "$A_JQ" "$file"; else jq . "$file"; fi
  ;;

path)
  resolve_session_readonly
  payload_path
  ;;

*) die "unknown subcommand: $CMD" ;;
esac
